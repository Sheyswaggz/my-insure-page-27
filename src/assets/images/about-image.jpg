// optimization-script.js
const sharp = require('sharp');
const fs = require('fs');

async function optimizeAboutImage(inputPath) {
  try {
    // Generate JPEG version
    await sharp(inputPath)
      .resize(800, 600, {
        fit: 'cover',
        position: 'center'
      })
      .jpeg({
        quality: 85,
        progressive: true,
        mozjpeg: true
      })
      .toFile('src/assets/images/about-image.jpg');

    // Generate WebP version
    await sharp(inputPath)
      .resize(800, 600, {
        fit: 'cover',
        position: 'center'
      })
      .webp({
        quality: 85,
        effort: 6
      })
      .toFile('src/assets/images/about-image.webp');

    // Verify file sizes
    const jpegStats = fs.statSync('src/assets/images/about-image.jpg');
    const webpStats = fs.statSync('src/assets/images/about-image.webp');

    console.log(`JPEG size: ${(jpegStats.size / 1024).toFixed(2)}KB`);
    console.log(`WebP size: ${(webpStats.size / 1024).toFixed(2)}KB`);

    if (jpegStats.size > 100 * 1024) {
      console.warn('WARNING: JPEG exceeds 100KB target');
    }

  } catch (error) {
    console.error('Image optimization failed:', error);
    throw error;
  }
}

// Usage: node optimization-script.js
optimizeAboutImage('path/to/source-image.jpg');