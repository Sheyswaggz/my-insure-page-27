# .env.example
# Environment Configuration Template for Local Development
# Copy this file to .env and fill in actual values
# NEVER commit .env file with real secrets to version control

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node Environment (development, production, test)
NODE_ENV=development

# Application Port (default: 5173 for Vite dev server)
PORT=5173

# Application Base URL (used for absolute URLs in production)
# Example: https://www.example-insurance.com
VITE_APP_BASE_URL=http://localhost:5173

# Application Name (displayed in browser title, meta tags)
VITE_APP_NAME="Insurance Company Landing Page"

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================

# Build Output Directory (relative to project root)
VITE_BUILD_OUTDIR=dist

# Enable Source Maps in Production (true/false)
VITE_BUILD_SOURCEMAP=false

# Minify Output (true/false)
VITE_BUILD_MINIFY=true

# =============================================================================
# ANALYTICS & TRACKING (Optional)
# =============================================================================

# Google Analytics Measurement ID
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID
# Example: GTM-XXXXXXX
VITE_GTM_CONTAINER_ID=

# Facebook Pixel ID
# Example: 1234567890123456
VITE_FB_PIXEL_ID=

# =============================================================================
# THIRD-PARTY INTEGRATIONS (Optional)
# =============================================================================

# Contact Form Submission Endpoint
# Example: https://formspree.io/f/your-form-id
VITE_CONTACT_FORM_ENDPOINT=

# reCAPTCHA Site Key (for form spam protection)
# Example: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
VITE_RECAPTCHA_SITE_KEY=

# =============================================================================
# API CONFIGURATION (Future Use)
# =============================================================================

# API Base URL (if backend API is added later)
# Example: https://api.example-insurance.com
VITE_API_BASE_URL=

# API Timeout (milliseconds)
VITE_API_TIMEOUT=30000

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable Live Chat Widget (true/false)
VITE_FEATURE_LIVE_CHAT=false

# Enable Quote Calculator (true/false)
VITE_FEATURE_QUOTE_CALCULATOR=false

# Enable Blog Section (true/false)
VITE_FEATURE_BLOG=false

# =============================================================================
# CONTENT CONFIGURATION
# =============================================================================

# Company Contact Email (displayed on contact page)
VITE_CONTACT_EMAIL=info@example-insurance.com

# Company Phone Number (displayed in header/footer)
VITE_CONTACT_PHONE=+1-800-123-4567

# Company Address (displayed in footer)
VITE_COMPANY_ADDRESS="123 Insurance St, Suite 100, City, ST 12345"

# Business Hours (displayed on contact page)
VITE_BUSINESS_HOURS="Monday-Friday: 9:00 AM - 5:00 PM EST"

# =============================================================================
# SOCIAL MEDIA LINKS (Optional)
# =============================================================================

# Facebook Page URL
VITE_SOCIAL_FACEBOOK=

# Twitter/X Profile URL
VITE_SOCIAL_TWITTER=

# LinkedIn Company Page URL
VITE_SOCIAL_LINKEDIN=

# Instagram Profile URL
VITE_SOCIAL_INSTAGRAM=

# =============================================================================
# SEO CONFIGURATION
# =============================================================================

# Default Meta Description (used if page-specific description not provided)
VITE_META_DESCRIPTION="Professional insurance solutions for individuals and businesses. Get comprehensive coverage with competitive rates."

# Default Meta Keywords (comma-separated)
VITE_META_KEYWORDS="insurance, coverage, quotes, protection, liability, health insurance, auto insurance"

# Open Graph Image URL (for social media sharing)
# Example: https://www.example-insurance.com/og-image.jpg
VITE_OG_IMAGE_URL=

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Enable Debug Mode (shows additional console logs)
VITE_DEBUG=false

# Enable Performance Monitoring (logs page load metrics)
VITE_PERFORMANCE_MONITORING=false

# Enable Hot Module Replacement (HMR) in development
VITE_HMR=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Content Security Policy (CSP) Nonce (generated per request in production)
VITE_CSP_NONCE=

# Allowed Origins for CORS (comma-separated, if API is added)
VITE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. All variables prefixed with VITE_ are exposed to the client-side code
# 2. Never store sensitive secrets in VITE_ variables as they are publicly accessible
# 3. Use server-side environment variables for sensitive data (API keys, secrets)
# 4. Boolean values should be lowercase strings: "true" or "false"
# 5. Empty values are treated as undefined/not set
# 6. Restart dev server after changing environment variables
# 7. Production deployments should set these via hosting platform environment variables
#
# =============================================================================